# frozen_string_literal: true

source "https://rubygems.org"

# The same gem set GitHub Pages' legacy build used, so the move to an
# Actions build doesn't change how any page renders. It pins Jekyll 3.10,
# kramdown and the whitelisted plugins.
gem "github-pages", group: :jekyll_plugins

# Standard-library gems that newer Rubies no longer bundle by default; they
# let the site build on a local Ruby 3.4 as well as CI's Ruby 3.3.
gem "base64"
gem "bigdecimal"
gem "csv"
gem "logger"
gem "webrick"
